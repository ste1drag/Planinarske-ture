specification {
  element externalSystem
  element service
  element layer
  element component
  element controller
  element consumer
  element handler
  element repository
  element database
  element messagebroker
  element entity
  element businessLogic

  tag critical
  tag async
  tag realtime
}


model {
  // External Systems
  externalSystem toursService 'Tours Service' {
    description 'Microservice responsible for managing hiking tours'
    style {
      icon tech:docker
      color red
    }
    technology '.NET 8, PostgreSQL'
    -> rabbitMQ 'Publishes TourCreatedEvent'
  }

  externalSystem gateway 'API Gateway' {
    description 'Gateway with SignalR hub for real-time communication'
    technology '.NET 8, SignalR, YARP'
    style {
      color secondary
    }
    -> frontend 'Pushes notifications via SignalR'
    -> notificationsApi 'Proxies HTTP requests'
    -> toursService 'Proxies HTTP requests'
  }

  externalSystem frontend 'Frontend Application' {
    description 'React-based web application'
    technology 'React, TypeScript, SignalR Client'

    style {
      icon tech:react
      shape browser
      color green
    }

  }

  // Infrastructure
  messagebroker rabbitMQ 'RabbitMQ' {
    description 'Message broker for event-driven communication'
    technology 'RabbitMQ, MassTransit'

    style {
      shape queue
      color amber
      icon tech:rabbitmq
    }

    -> notificationsService.applicationLayer.tourCreatedConsumer 'TourCreatedEvent queue'
    -> gateway 'InAppNotificationCreatedTourEvent'
  }

  database mongodb 'MongoDB' {
    description 'NoSQL database for notification storage'
    technology 'MongoDB 7.0'
    style {
      color amber
      shape storage
      icon tech:mongodb
    }
  }

  // Notifications Service
  service notificationsService 'Notifications Service' {
    description 'Microservice for managing in-app notifications in the Mountain Tours application'
    technology '.NET 8, Clean Architecture'

    style {

      icon tech:docker
    }

    // ============================================
    // PRESENTATION LAYER
    // ============================================
    layer presentationLayer 'Presentation Layer' {
      description 'API Controllers - HTTP interface'
      style {
        color secondary
      }

      controller notificationsApi 'InAppNotificationsController' {
        description 'REST API endpoints for notification CRUD operations'
        technology 'ASP.NET Core, MediatR'

        -> mediator 'Sends Commands/Queries'
      }
    }

    // ============================================
    // APPLICATION LAYER
    // ============================================
    layer applicationLayer 'Application Layer' {
      description 'Business logic, Use Cases, CQRS, Event Consumers'
      style {
        color primary
      }

      // Event Consumer
      consumer tourCreatedConsumer 'TourCreatedEventConsumer' {
        description 'Consumes TourCreatedEvent from RabbitMQ and initiates notification creation'
        technology 'MassTransit, IConsumer'

        -> mediator 'Sends CreateInAppNotificationCommand'
      }

      // Mediator (CQRS)
      component mediator 'MediatR Pipeline' {
        description 'CQRS mediator - routes commands and queries to handlers'
        technology 'MediatR, FluentValidation'

        -> createCommandHandler 'Routes CreateInAppNotificationCommand'
        -> updateCommandHandler 'Routes UpdateInAppNotificationCommand'
        -> deleteCommandHandler 'Routes DeleteInAppNotificationCommand'
        -> getAllQueryHandler 'Routes GetAllInAppNotificationsQuery'
        -> getByIdQueryHandler 'Routes GetInAppNotificationQuery'
        -> getByTourIdQueryHandler 'Routes GetInAppNotificationsByTourIdQuery'
      }

      // Command Handlers
      handler createCommandHandler 'CreateInAppNotificationCommandHandler' {
        description 'Handles notification creation with business rules and event publishing'
        technology 'IRequestHandler, AutoMapper'

        -> notificationsService.domainLayer.deliveryRules 'Applies creation rules'
        -> notificationsService.infrastructureLayer.notificationRepository 'Persists notification'
        -> rabbitMQ 'Publishes InAppNotificationCreatedTourEvent'
      }

      handler updateCommandHandler 'UpdateInAppNotificationCommandHandler' {
        description 'Handles notification updates'
        technology 'IRequestHandler, AutoMapper'

        -> notificationsService.infrastructureLayer.notificationRepository 'Updates notification'
      }

      handler deleteCommandHandler 'DeleteInAppNotificationCommandHandler' {
        description 'Handles notification deletion'
        technology 'IRequestHandler'

        -> notificationsService.infrastructureLayer.notificationRepository 'Deletes notification'
      }

      // Query Handlers
      handler getAllQueryHandler 'GetAllInAppNotificationsQueryHandler' {
        description 'Retrieves all notifications'
        technology 'IRequestHandler, AutoMapper'

        -> notificationsService.infrastructureLayer.notificationRepository 'Fetches all notifications'
      }

      handler getByIdQueryHandler 'GetInAppNotificationQueryHandler' {
        description 'Retrieves notification by ID'
        technology 'IRequestHandler, AutoMapper'

        -> notificationsService.infrastructureLayer.notificationRepository 'Fetches by ID'
      }

      handler getByTourIdQueryHandler 'GetInAppNotificationsByTourIdQueryHandler' {
        description 'Retrieves notifications for specific tour'
        technology 'IRequestHandler, AutoMapper'

        -> notificationsService.infrastructureLayer.notificationRepository 'Fetches by TourId'
      }
    }

    // ============================================
    // DOMAIN LAYER
    // ============================================
    layer domainLayer 'Domain Layer' {
      description 'Core business entities and domain logic'
      style {
        color muted
      }

      entity inAppNotification 'InAppNotification Entity' {
        description 'Core notification entity with status management and timestamps'
        technology 'Domain Entity, Rich Model'
      }

      businessLogic deliveryRules 'NotificationDeliveryRules' {
        description 'Business rules for notification lifecycle: creation, delivery, status transitions'
        technology 'Static Business Logic'

        -> inAppNotification 'Applies rules to entity'
      }
    }

    // ============================================
    // INFRASTRUCTURE LAYER
    // ============================================
    layer infrastructureLayer 'Infrastructure Layer' {
      description 'Data persistence and external service integrations'
      style {
        color secondary
      }

      repository notificationRepository 'MongoInAppNotificationRepository' {
        description 'MongoDB repository implementation for notification persistence'
        technology 'MongoDB.Driver, IOptions'

        -> mongodb 'CRUD operations on notifications collection'
      }
    }
  }
}

views {
  // ============================================
  // MAIN EVENT FLOW VIEW
  // ============================================
  /**
   * @likec4-generated(v1)
   * 
   * 
   * 
   * 
   */
  view eventFlow {
    title 'Notifications Service - Event Flow Architecture'
    description 'Complete event-driven flow showing TourCreatedEvent consumption, processing, and notification delivery'

    // Include external systems
    include toursService
    include gateway
    include frontend
    include rabbitMQ
    include mongodb

    // Include all layers and their components
    include notificationsService.presentationLayer.*
    include notificationsService.applicationLayer.*
    include notificationsService.domainLayer.*
    include notificationsService.infrastructureLayer.*

    // Auto layout
    autoLayout TopBottom
    style rabbitMQ {
      shape queue
    }
    style mongodb {
      shape storage
    }
  }

  // ============================================
  // TOUR CREATED EVENT FLOW
  // ============================================
  view tourCreatedEventFlow {
    title 'Tour Created Event - End-to-End Flow'
    description 'Detailed flow from tour creation to real-time notification delivery to frontend'

    // External trigger
    include toursService
    include rabbitMQ -> notificationsService.applicationLayer.tourCreatedConsumer

    // Event processing
    include notificationsService.applicationLayer.tourCreatedConsumer -> notificationsService.applicationLayer.mediator
    include notificationsService.applicationLayer.mediator -> notificationsService.applicationLayer.createCommandHandler
    include notificationsService.applicationLayer.createCommandHandler -> notificationsService.domainLayer.deliveryRules
    include notificationsService.domainLayer.deliveryRules -> notificationsService.domainLayer.inAppNotification
    include notificationsService.applicationLayer.createCommandHandler -> notificationsService.infrastructureLayer.notificationRepository
    include notificationsService.infrastructureLayer.notificationRepository -> mongodb

    // Event publishing
    include notificationsService.applicationLayer.createCommandHandler -> rabbitMQ
    include rabbitMQ -> gateway
    include gateway -> frontend

    autoLayout LeftRight
  }

  // ============================================
  // REST API FLOW
  // ============================================
  view restApiFlow {
    title 'REST API Operations Flow'
    description 'HTTP request flow through Clean Architecture layers for CRUD operations'

    include frontend
    include gateway -> notificationsService.presentationLayer.notificationsApi

    // Command flow (Create/Update/Delete)
    include notificationsService.presentationLayer.notificationsApi -> notificationsService.applicationLayer.mediator
    include notificationsService.applicationLayer.mediator -> notificationsService.applicationLayer.createCommandHandler
    include notificationsService.applicationLayer.mediator -> notificationsService.applicationLayer.updateCommandHandler
    include notificationsService.applicationLayer.mediator -> notificationsService.applicationLayer.deleteCommandHandler
    include notificationsService.applicationLayer.createCommandHandler -> notificationsService.domainLayer.deliveryRules
    include notificationsService.domainLayer.deliveryRules -> notificationsService.domainLayer.inAppNotification
    include notificationsService.applicationLayer.createCommandHandler -> notificationsService.infrastructureLayer.notificationRepository
    include notificationsService.applicationLayer.updateCommandHandler -> notificationsService.infrastructureLayer.notificationRepository
    include notificationsService.applicationLayer.deleteCommandHandler -> notificationsService.infrastructureLayer.notificationRepository
    include notificationsService.infrastructureLayer.notificationRepository -> mongodb

    // Query flow (Read)
    include notificationsService.applicationLayer.mediator -> notificationsService.applicationLayer.getAllQueryHandler
    include notificationsService.applicationLayer.mediator -> notificationsService.applicationLayer.getByIdQueryHandler
    include notificationsService.applicationLayer.mediator -> notificationsService.applicationLayer.getByTourIdQueryHandler
    include notificationsService.applicationLayer.getAllQueryHandler -> notificationsService.infrastructureLayer.notificationRepository
    include notificationsService.applicationLayer.getByIdQueryHandler -> notificationsService.infrastructureLayer.notificationRepository
    include notificationsService.applicationLayer.getByTourIdQueryHandler -> notificationsService.infrastructureLayer.notificationRepository

    autoLayout TopBottom
  }

  // ============================================
  // ARCHITECTURAL LAYERS VIEW
  // ============================================
  view layeredArchitecture of notificationsService {
    title 'Clean Architecture - Layered View'
    description 'Four-layer architecture with clear separation of concerns and dependency rules'

    include notificationsService.presentationLayer
    include notificationsService.applicationLayer
    include notificationsService.domainLayer
    include notificationsService.infrastructureLayer

    autoLayout TopBottom
  }

  // ============================================
  // APPLICATION LAYER DETAIL
  // ============================================
  /**
   * @likec4-generated(v1)
   * 
   * 
   * 
   * 
   * 
   * 
   * 
   * eTiCoWyEoXjNCyqhec0EGKV3aWR0aMzTpmhlaWdodCOhcJSSzQqGzQQYks0K6s0EGJLNC2nNBBiSzQvOzQQY
   */
  view applicationLayerDetail of notificationsService.applicationLayer {
    title 'Application Layer - CQRS Pattern'
    description 'Detailed view of CQRS implementation with MediatR, command/query handlers, and event consumers'

    include *
    include rabbitMQ -> notificationsService.applicationLayer.tourCreatedConsumer
    include notificationsService.infrastructureLayer.notificationRepository
    include notificationsService.domainLayer.deliveryRules
    include mongodb

    autoLayout LeftRight
  }

  // ============================================
  // INFRASTRUCTURE INTEGRATION
  // ============================================
  view infrastructureIntegration {
    title 'Infrastructure Integration'
    description 'External system integrations: RabbitMQ for messaging and MongoDB for persistence'

    include toursService -> rabbitMQ
    include rabbitMQ -> notificationsService.applicationLayer.tourCreatedConsumer
    include notificationsService.applicationLayer.createCommandHandler
    include notificationsService.applicationLayer.createCommandHandler -> rabbitMQ
    include rabbitMQ -> gateway
    include notificationsService.infrastructureLayer.notificationRepository -> mongodb

    autoLayout LeftRight
  }

  // ============================================
  // SYSTEM CONTEXT
  // ============================================
  /**
   * @likec4-generated(v1)
   * 
   * 
   * ApeSzQPTzQJ3ks0D1M0CU5LNA8vNAjOSzQOczQGQks0Db80BcJLNAwDM8JLNAvDM3pLNAt7MzJLNAsvMu6ZrMmk4YnaCoWyEoXjNAROhec0CEKV3aWR0aMzTpmhlaWdodCOhcJqSzQGuzQHgks0BnM0B6JLNAYnNAfCSzQF3zQH3ks0BNM0CEpLNARDNAf2SzN/NAjOSzMnNAkuSzLzNAm2SzLTNAow=
   */
  view systemContext {
    title 'System Context - Notifications Service'
    description 'High-level view showing how Notifications Service fits in the microservices ecosystem'

    include toursService
    include notificationsService
    include gateway
    include frontend
    include rabbitMQ
    include mongodb

    autoLayout TopBottom
  }

  // ============================================
  // DATA PERSISTENCE FLOW
  // ============================================
  view dataPersistence {
    title 'Data Persistence Flow'
    description 'How notifications are persisted through repository pattern to MongoDB'

    include notificationsService.applicationLayer.mediator
    include notificationsService.applicationLayer.createCommandHandler
    include notificationsService.applicationLayer.updateCommandHandler
    include notificationsService.applicationLayer.deleteCommandHandler
    include notificationsService.applicationLayer.getAllQueryHandler
    include notificationsService.applicationLayer.getByIdQueryHandler
    include notificationsService.applicationLayer.getByTourIdQueryHandler
    include notificationsService.infrastructureLayer.notificationRepository
    include mongodb
    include notificationsService.domainLayer.inAppNotification
    include notificationsService.domainLayer.deliveryRules

    autoLayout TopBottom
  }
}
